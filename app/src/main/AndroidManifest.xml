<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No INTERNET, Bluetooth or location permission. The merged manifest holds only AndroidX's
        app-private receiver permission, androidx.biometric's USE_BIOMETRIC / USE_FINGERPRINT (normal
        permissions, granted at install) and CAMERA, asked for only when you open Scan, to read
        friends' QR codes. ManifestHardeningTest enforces this list.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Phones without a camera can still install TFL: friends scan their code instead. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".TflApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TFL"
        tools:targetApi="31">

        <!-- Opened only through the launcher aliases below (and by the calculator after its code). -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TFL.Starting"
            android:windowSoftInputMode="adjustResize" />

        <!-- Declared here so it precedes the alias that targets it (from :feature:onboarding). -->
        <activity android:name="app.tfl.feature.onboarding.stealth.CalculatorActivity" />

        <!--
            The launcher entries. Exactly one is enabled at a time; CalculatorDisguise swaps them. Their
            names are fixed (namespace app.tfl) in every build type.
        -->
        <activity-alias
            android:name=".LauncherDefault"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calculator"
            android:label="@string/calculator_label"
            android:roundIcon="@mipmap/ic_calculator"
            android:targetActivity="app.tfl.feature.onboarding.stealth.CalculatorActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
