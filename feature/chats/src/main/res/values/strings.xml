    <!-- Disappearing messages -->
    <string name="chat_disappearing">Disappearing messages</string>
    <string name="chat_disappearing_explained">New messages in this chat disappear from both phones after the time you choose: on yours, counted from sending; on %1$s\'s, from when it arrives. They\'re erased from the encrypted database, not just hidden. Anyone can still copy or photograph a message before then.</string>
