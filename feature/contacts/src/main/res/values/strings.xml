    <!-- Why a scanned code was refused -->
    <string name="pairing_problem_not_tfl">That isn\'t a TFL pairing code.</string>
    <string name="pairing_problem_unreadable">That code is damaged or incomplete. Try again, a little closer.</string>
    <string name="pairing_problem_version">That code was made by a different version of TFL. Update both phones to the same version.</string>
    <string name="pairing_problem_signature">That code\'s signature doesn\'t match its contents: it was changed after it was made. Don\'t add this person.</string>
    <plurals name="pairing_problem_expired">
        <item quantity="one">This code was made %d minute ago and has expired (codes last 5 minutes). Ask your friend for their current code.</item>
        <item quantity="other">This code was made %d minutes ago and has expired (codes last 5 minutes). Ask your friend for their current code.</item>
    </plurals>
    <plurals name="pairing_problem_future">
        <item quantity="one">Your friend\'s clock is %d minute ahead of yours. Set both phones to automatic time, then try again.</item>
        <item quantity="other">Your friend\'s clock is %d minutes ahead of yours. Set both phones to automatic time, then try again.</item>
    </plurals>
    <string name="pairing_problem_name">That code\'s name contains invisible or control characters, which can disguise a name. TFL won\'t add it.</string>
    <string name="pairing_problem_own_code">That\'s your own code. Scan your friend\'s.</string>

