    <string name="add_friend_refused_title">Code not added</string>
    <string name="add_friend_scan_hint">Point the camera at your friend\'s code. It\'s read on this phone; nothing is saved or sent.</string>
    <string name="add_friend_namesake_title">Same person as %1$s?</string>
    <string name="add_friend_namesake_body">You already have %1$s, with a different key. Their key changes if they reinstalled TFL or switched phones, but this could also be someone else using the same name. Choose \"Same person\" only if it\'s really them, in front of you.</string>
    <string name="add_friend_namesake_same">Same person, new key</string>
    <string name="add_friend_namesake_other">Someone else</string>
