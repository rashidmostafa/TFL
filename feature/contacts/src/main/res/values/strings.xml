    <!-- Camera -->
    <string name="camera_rationale_title">Camera needed to scan</string>
    <string name="camera_rationale_body">The camera is used only to read your friend\'s code. Frames stay in memory on this phone and are never saved or sent.</string>
    <string name="camera_rationale_allow">Allow camera</string>
    <string name="camera_blocked_title">Camera access is off</string>
    <string name="camera_blocked_body">TFL can\'t scan codes without the camera. Turn on Camera for TFL in Settings. Your own code works either way.</string>
    <string name="camera_blocked_settings">Open settings</string>
    <string name="camera_unavailable">No camera is available on this phone. Your friend can still scan your code.</string>

