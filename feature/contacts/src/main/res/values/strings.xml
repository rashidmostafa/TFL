    <!-- Add friend -->
    <string name="add_friend_title">Add friend</string>
    <string name="add_friend_tab_my_code">My QR</string>
    <string name="add_friend_tab_scan">Scan</string>
    <string name="add_friend_intro">Add friends in person only. Each of you scans the other\'s code. It holds only public keys, nothing secret.</string>
    <string name="add_friend_window_closed">More than 5 minutes passed, so that pairing expired. Start again: one of you shows a code, the other scans it.</string>
    <string name="add_friend_scan_theirs_title">Ready to scan theirs?</string>
    <string name="add_friend_scan_theirs_subtitle">Switch to the camera</string>
    <string name="add_friend_code_footnote">Your code changes every minute and is accepted for 5 minutes, so a photo of it soon stops working.</string>
    <string name="add_friend_answer_verified_title">%1$s is verified in person</string>
    <string name="add_friend_answer_verified_body">One more: let %1$s scan your code, so their phone verifies you too.</string>
    <string name="add_friend_answer_added_title">%1$s added, not verified yet</string>
    <string name="add_friend_answer_added_body">Now let %1$s scan your code. Then scan the code their phone shows next, and you\'re both verified.</string>
    <string name="add_friend_scan_their_answer">Scan their code</string>
    <string name="add_friend_scan_their_answer_hint">Scan the code %1$s\'s phone shows now.</string>
    <string name="add_friend_stop_here">Stop here (not verified)</string>
    <string name="add_friend_done">Done</string>
    <string name="add_friend_key_type">ED25519</string>
