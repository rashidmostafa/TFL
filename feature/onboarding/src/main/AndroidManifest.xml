<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Target of the "Calculator" launcher alias in the app manifest; not reachable directly. Its own
            task affinity keeps it out of TFL's task, so recent apps show a calculator, not TFL.
        -->
        <activity
            android:name=".stealth.CalculatorActivity"
            android:exported="false"
            android:label="@string/calculator_label"
            android:taskAffinity="${applicationId}.calculator"
            android:theme="@style/Theme.Calculator" />
    </application>

</manifest>
