<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a splash for every launch: make it the calculator's, never TFL's. -->
    <style name="Theme.Calculator" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/calculator_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/calculator_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_calculator_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/calculator_icon_background</item>
    </style>
</resources>
