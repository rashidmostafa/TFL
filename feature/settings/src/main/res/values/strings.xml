    <string name="pin_flow_disguise_intro_title">How the disguise works</string>
    <string name="pin_flow_disguise_intro_icon">TFL\'s icon becomes a working calculator called Calculator, and TFL disappears from recent apps.</string>
    <string name="pin_flow_disguise_intro_open">To open TFL, type your secret code in the calculator and press =. Then enter your PIN as usual.</string>
    <string name="pin_flow_disguise_intro_close">TFL closes as soon as you turn the disguise on, and locks whenever you leave it.</string>
